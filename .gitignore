# Xcode
build/
DerivedData/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
*.xcworkspace/xcuserdata/
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# XcodeGen generates the .xcodeproj from project.yml — don't commit the generated project
*.xcodeproj/

# Swift Package Manager
.build/
.swiftpm/

# CocoaPods (not used, kept for safety)
Pods/

# Secrets — NEVER commit real API keys.
# Copy Configuration/Secrets.example.xcconfig to Configuration/Secrets.xcconfig
# and fill in real values. Secrets.xcconfig is gitignored on purpose.
Configuration/Secrets.xcconfig
.env
.env.local

# Web app config — copy web/config.example.js to web/config.js and fill in
# your Supabase URL + anon key there.
web/config.js

# macOS
.DS_Store

# Fastlane / CI artifacts
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# web/vendor/ SÍ se sube al repositorio, a propósito: es la copia local
# de supabase-js, y tenerla dentro hace que desplegar sea clonar y poner
# config.js, sin depender de que un CDN de fuera siga en pie. Ver
# docs/subir-a-internet.md.

# La copia que deja scripts/sin-cuenta-de-pago.sh
project.yml.con-cuenta-de-pago
