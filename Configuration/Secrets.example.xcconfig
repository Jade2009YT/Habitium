//
//  Secrets.example.xcconfig
//  Habitium
//
//  TEMPLATE — copy this file to `Secrets.xcconfig` in the same folder and
//  fill in your real values there. `Secrets.xcconfig` is listed in
//  .gitignore and will never be committed to the repository.
//
//    cp Configuration/Secrets.example.xcconfig Configuration/Secrets.xcconfig
//
//  Xcode build settings cannot contain certain characters (spaces, quotes,
//  most punctuation) unescaped, so API keys are injected here and exposed
//  to the app at runtime through Info.plist placeholders — see
//  AppConfiguration.swift for how they're read.
//

// OpenAI API key, used for GPT-4o Vision meal analysis.
// Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY = your_openai_api_key_here

// Anthropic (Claude) API key, used as an alternative meal-analysis provider.
// Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY = your_anthropic_api_key_here

// App Group identifier shared between the app and the widget extension.
// Must match the App Group enabled in both targets' entitlements and in
// your Apple Developer account / provisioning profiles.
APP_GROUP_ID = group.com.habitium.app

// Supabase project — email/password sign-up + sign-in, AND the cloud
// copy of your data that keeps the iPhone, the web app (web/) and any
// future client showing the same thing. Create a free project at
// https://supabase.com, apply supabase/schema.sql in its SQL Editor,
// then grab these from Project Settings > API.
//
// Fill in the SAME two values you put in web/config.js — that's what
// makes the app and the website share an account and its data. Signing
// into both with the same email is the whole link; there's nothing else
// to connect.
//
// SUPABASE_ANON_KEY: the PUBLIC key. Depending on when your project was
// created it's labelled `anon / public` (starts with "eyJ...") or, in
// the newer format, `publishable` (starts with "sb_publishable_").
// Either works. Never put the `service_role` / `secret` one here.
//
// IMPORTANT: xcconfig treats "//" as a start-of-comment marker, so the URL
// is split into scheme + host here instead of one https://... string —
// AppConfiguration.swift reassembles it. Just paste the two pieces below,
// no https:// prefix on the host, and no /rest/v1 at the end.
SUPABASE_URL_SCHEME = https
SUPABASE_URL_HOST = your_project_ref.supabase.co
SUPABASE_ANON_KEY = your_supabase_public_key_here
